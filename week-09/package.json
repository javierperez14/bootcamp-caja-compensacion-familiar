{
  "name": "proyecto-semana-09",
  "version": "1.0.0",
  "description": "Proyecto: Testing con Jest + Supertest + MongoDB Memory Server — Dominio: Caja de Compensación Familiar",
  "main": "dist/server.js",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:coverage": "jest --coverage --runInBand"
  },
  "dependencies": {
    "bcrypt": "5.1.1",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "express": "5.1.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.13.2",
    "morgan": "1.10.0",
    "winston": "3.17.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.1",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.9",
    "@types/morgan": "1.9.9",
    "@types/node": "22.15.3",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "mongodb-memory-server": "10.1.4",
    "supertest": "7.0.0",
    "ts-jest": "29.3.2",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
